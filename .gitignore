# Python bytecode and build outputs
# NOTE: these are anchored to the repo root (leading "/") because unanchored
# patterns like "lib/" match at any depth - "lib/" alone silently ignored
# frontend/src/lib/ (including api.ts), which meant that directory was never
# committed to this repo, in any commit, since the very first one.
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg

# Python environments and tooling
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Node, React, Vite, and frontend tests
node_modules/
.npm/
.yarn/
.pnpm-store/
dist/
coverage/
.vite/
.turbo/
playwright-report/
test-results/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and local configuration
.env
.env.*
!.env.example
*.local

# Docker local overrides and runtime artifacts
docker-compose.override.yml
compose.override.yml
*.pid
*.pid.lock

# IDEs and editors
.idea/
.vscode/
*.code-workspace
*.swp
*.swo
*~

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# General logs and temporary files
*.log
*.tmp
*.temp
.cache/
tmp/
temp/
