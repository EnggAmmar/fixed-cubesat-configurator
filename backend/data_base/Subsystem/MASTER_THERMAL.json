  "selection_hooks": {
    "hard_constraints": [
      "sum(active_thermal.power_avg_W) <= mission.available_thermal_control_power_W",
      "thermal_interface_materials require compatible mounting surfaces",
      "thermoelectric_coolers require heat_sink_or_radiator == true",
      "heat_pumps and cryocoolers require bus_size_u >= recommended_bus_min_u when specified",
      "thermal_coatings are valid only for external surfaces or radiator surfaces",
      "mli options may be limited by deployer clearance and external protrusions"
    ],
    "suggested_scoring_fields": [
      {
        "field": "normalized.mass_kg",
        "goal": "minimize",
        "weight_hint": 0.2
      },
      {
        "field": "normalized.power_avg_W",
        "goal": "minimize",
        "weight_hint": 0.2
      },
      {
        "field": "performance.thermal_emittance",
        "goal": "match_required_heat_rejection",
        "weight_hint": 0.15
      },
      {
        "field": "performance.solar_absorptance",
        "goal": "match_hot_or_cold_bias",
        "weight_hint": 0.15
      },
      {
        "field": "performance.heat_transport_W_estimate",
        "goal": "maximize_if_high_heat_load",
        "weight_hint": 0.15
      },
      {
        "field": "trl",
        "goal": "maximize",
        "weight_hint": 0.15
      }
    ],
    "rule_notes": [
      "Start with passive options: coatings, MLI, straps, heat pipes, and TIMs.",
      "Add heaters when eclipse survival or tight minimum temperature control is needed.",
      "Add TECs only when a detector or payload needs local cooling and there is radiator margin.",
      "Louvers and fluid-loop/heat-pump architectures should be treated as advanced options for high-power or variable-thermal-load missions.",
      "For CubeSats, NASA notes that passive technologies dominate because mass, volume, and power are limited; active systems are useful for tighter temperature control but can be power/volume constrained."
    ]
  }
}