  "selection_hooks": {
    "hard_constraints": [
      "comm.performance.max_data_rate_Mbps >= mission.required_downlink_mbps",
      "comm.band intersects mission.allowed_frequency_bands when specified",
      "antenna.band intersects selected_transmitter.band",
      "antenna.performance.gain_dBi >= mission.min_antenna_gain_dBi when specified",
      "selected_comm.normalized.power_tx_W + selected_antenna.normalized.power_avg_W <= mission.comm_power_budget_W when specified",
      "selected_comm.normalized.mass_kg + selected_antenna.normalized.mass_kg <= mission.comm_mass_budget_kg when specified"
    ],
    "compatibility_rules": [
      "UHF/VHF TT&C links are safe-mode/tumbling-tolerant and should be kept as backup links for most missions.",
      "S-band transmitters support low-to-medium data payload downlink and moderate pointing needs.",
      "X-band and Ka-band payload downlinks require fine pointing and higher ADCS capability.",
      "High-gain X/Ka antennas require compatible ADCS pointing accuracy and ground-station support.",
      "Transceivers can satisfy both transmitter and receiver roles if the solver allows combined hardware."
    ],
    "suggested_scoring_fields": [
      {
        "field": "performance.max_data_rate_Mbps",
        "goal": "maximize",
        "weight_hint": 0.25
      },
      {
        "field": "normalized.mass_kg",
        "goal": "minimize",
