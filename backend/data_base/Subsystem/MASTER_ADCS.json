  "selection_hooks": {
    "hard_constraints": [
      "For imaging/high-pointing missions, selected sensor+actuator chain must provide performance.pointing_accuracy_deg <= mission.max_pointing_error_deg when an integrated ADCS unit is selected.",
      "For non-integrated chains, star tracker or horizon/sun/magnetometer sensor accuracy must be compatible with mission pointing class.",
      "reaction_wheel or CMG actuation must satisfy required agility/momentum class when precision pointing is required.",
      "magnetorquer is required for detumbling and/or reaction-wheel momentum dumping in LEO unless another desaturation method is selected.",
      "cold_gas_thruster/electrospray_thruster requires compatible propulsion/power budget and shall not be auto-selected for simple low-cost missions unless mission requires delta-v or ultra-fine pointing.",
      "sum(normalized.mass_kg) <= mission.adcs_mass_budget_kg if a separate ADCS mass budget is provided.",
      "sum(normalized.power_avg_W) <= mission.adcs_avg_power_budget_W if a separate ADCS power budget is provided."
    ],
    "suggested_scoring_fields": [
      {
        "field": "performance.pointing_accuracy_deg",
        "goal": "minimize",
        "weight_hint": 0.3
      },
      {
        "field": "normalized.mass_kg",
        "goal": "minimize",
        "weight_hint": 0.18
      },
      {
        "field": "normalized.power_avg_W",
        "goal": "minimize",
        "weight_hint": 0.18
      },
      {
        "field": "trl",
        "goal": "maximize",
        "weight_hint": 0.14
      },
      {
        "field": "performance.slew_rate_max_deg_s",
        "goal": "maximize",
        "weight_hint": 0.08
      },
      {
        "field": "performance.momentum_storage_mNms",
        "goal": "maximize",
        "weight_hint": 0.07
      },
      {
        "field": "data_confidence",
        "goal": "prefer_public_spec",
        "weight_hint": 0.05
      }
    ],
    "mission_class_rules": {
      "low_precision_iot_navigation": [
        "coarse sun sensor + magnetometer + magnetorquer may be sufficient",
        "avoid star tracker unless payload pointing requirement is below ~0.5 deg"
      ],
      "earth_observation_medium_precision": [
        "fine sun sensor or horizon sensor plus reaction wheels recommended",
        "star tracker recommended if pointing requirement is below ~0.1 deg"
      ],
      "vhr_or_hyperspectral_high_precision": [
        "star tracker + reaction wheels or integrated XACT/CubeADCS class ADCS required",
        "magnetorquer included for desaturation"
      ],
      "rapid_retargeting_or_agile_imaging": [
        "consider CMG or high-momentum reaction wheel set",
        "penalize power/mass strongly for small buses"
      ],
      "drag_free_or_ultra_precision": [
        "consider electrospray/FEEP actuator class",
        "requires dedicated power and propulsion compatibility checks"
      ]
    },
    "trace_explanations": [
      "Star trackers improve attitude knowledge but add cost and integration constraints.",
      "Reaction wheels provide fine pointing; magnetorquers provide detumbling and momentum dumping.",
      "CMGs are high-agility options for larger buses or rapid retargeting.",
      "Cold gas and electrospray thrusters are only selected when attitude control requirements justify propulsion-like actuators."
    ]
  }
}